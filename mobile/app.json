{
  "expo": {
    "name": "VibeCam",
    "slug": "vibecam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibecam.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow VibeCam to access the camera to take photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow VibeCam to save your graded photos to your photo library.",
        "NSPhotoLibraryUsageDescription": "Allow VibeCam to save and access photos you capture in the app."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vibecam.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "054f74da-a7ed-4340-84cb-eb5f257ae716"
      }
    },
    "owner": "hayyyyy",
    "plugins": [
      "expo-video",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow VibeCam to access the camera to take photos.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow VibeCam to save and access photos you capture in the app.",
          "savePhotosPermission": "Allow VibeCam to save your graded photos to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset"
    ]
  }
}
