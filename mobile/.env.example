# Mobile environment (Expo)
# iOS simulator and web default
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Android emulator example
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical device example (replace with your machine LAN IP)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000

# Production example (Render)
# EXPO_PUBLIC_API_BASE_URL=https://vibecam-backend.onrender.com

# Must match VIBECAM_API_KEY on the backend. Leave empty for local dev.
# Note: EXPO_PUBLIC_* values are embedded in the app bundle, so this guards against
# strangers hitting your URL — it is not a secret from someone holding the build.
EXPO_PUBLIC_API_KEY=
