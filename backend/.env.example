# Backend environment
VIBECAM_MAX_UPLOAD_BYTES=52428800
VIBECAM_UPLOAD_TTL_MINUTES=15

# Shared secret required on every request except /health (sent as the X-API-Key header).
# Leave empty for local dev to keep the API open. SET THIS for any deployment that is
# reachable from the internet, otherwise anyone with the URL can use your /grade compute
# and fill your disk via /uploads. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VIBECAM_API_KEY=

# AI Provider (gemini or openai)
AI_PROVIDER=gemini

# Google AI (Gemini) — get from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# OpenAI (alternative) — get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=
